# Copy to .env and fill in. .env is git-ignored; config.toml keys win over these.
# Folders that are git repos or hold them (2 levels deep), ';'-separated
WORKLOG_REPO_ROOTS='D:\dev\alpha;D:\dev\xyz'
# Jira project keys, ','-separated
WORKLOG_PROJECT_KEYS=ABC,XYZ
# Project of the work in each root: root=KEY, ';'-separated
WORKLOG_REPO_PROJECTS='D:\dev\alpha=ABC;D:\dev\xyz=XYZ'
# Jira base URL (else JIRA_URL from the environment or the ctx .env)
JIRA_URL=https://jira.example.org
# Provider entry in ~/.config/opencode/opencode.json whose endpoint and key are borrowed, and the model
WORKLOG_LLM_PROVIDER=myllm
WORKLOG_LLM_MODEL=my-model
# Extra Jira fields for every new ticket, as Jira REST JSON
WORKLOG_TICKET_FIELDS='{"customfield_10000":{"value":"development"}}'
